
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EduSpace - فضاؤك للتعلم</title>

<style>
* { box-sizing: border-box; }

body {
  margin: 0;
  font-family: Tahoma, Arial, sans-serif;
  background: #f7f9fc;
  color: #263b65;
}

header {
  background: white;
  padding: 20px;
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 15px;
}

.logo { font-size: 24px; font-weight: bold; }
.logo span { color: #5478e8; }

nav a {
  margin: 8px;
  text-decoration: none;
  color: #263b65;
}

.hero {
  text-align: center;
  padding: 65px 15px;
  background: #eaf0ff;
}

.hero h1 { font-size: 35px; }
.hero p { line-height: 2; color: #68758b; }

button {
  background: #5478e8;
  color: white;
  border: 0;
  padding: 12px 18px;
  border-radius: 8px;
  cursor: pointer;
}

section {
  padding: 45px 7%;
  text-align: center;
}

#search {
  padding: 13px;
  width: 90%;
  max-width: 400px;
  border: 1px solid #ddd;
  border-radius: 8px;
  margin: 20px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2,1fr);
  gap: 18px;
}

.card {
  background: white;
  padding: 25px;
  border-radius: 14px;
  box-shadow: 0 4px 15px #0000000d;
}

.card .emoji { font-size: 35px; }
.card p { color: #778397; line-height: 1.8; }

#quiz { background: #eaf0ff; }

.answers {
  display: flex;
  justify-content: center;
  gap: 10px;
  flex-wrap: wrap;
}

footer {
  background: #263b65;
  color: white;
  text-align: center;
  padding: 25px;
}

@media(max-width:600px) {
  .grid { grid-template-columns: 1fr; }
  header { justify-content: center; }
  .hero h1 { font-size: 27px; }
}
</style>
</head>

<body>

<header>
  <div class="logo">Edu<span>Space</span> 🎓</div>
  <nav>
    <a href="#home">الرئيسية</a>
    <a href="#courses">الدروس</a>
    <a href="#quiz">الاختبار</a>
  </nav>
</header>

<div class="hero" id="home">
  <h1>تعلم اليوم، واصنع مستقبلك غداً!</h1>
  <p>اكتشف مهارات جديدة وتعلم أشياء مفيدة في أي وقت.</p>
  <a href="#courses"><button>اكتشف الدروس</button></a>
</div>

<section id="courses">
  <h2>📚 مجالات التعلم</h2>
  <p>اختر المجال الذي تحب تعلمه</p>

  <input id="search" placeholder="ابحث عن درس...">

  <div class="grid" id="courseList">

    <div class="card">
      <div class="emoji">💻</div>
      <h3>البرمجة</h3>
      <p>تعلم صناعة المواقع والبرمجة.</p>
      <button onclick="info('ابدأ بتعلم HTML ثم CSS ثم JavaScript')">اكتشف المزيد</button>
    </div>

    <div class="card">
      <div class="emoji">📈</div>
      <h3>التسويق الرقمي</h3>
      <p>تعلم التسويق وفهم العملاء.</p>
      <button onclick="info('تعلم الجمهور المستهدف وصناعة الإعلانات')">اكتشف المزيد</button>
    </div>

    <div class="card">
      <div class="emoji">🎨</div>
      <h3>التصميم</h3>
      <p>تعلم تصميم الصور والإعلانات.</p>
      <button onclick="info('ابدأ بتعلم التصميم باستخدام Canva')">اكتشف المزيد</button>
    </div>

    <div class="card">
      <div class="emoji">🤖</div>
      <h3>الذكاء الاصطناعي</h3>
      <p>اكتشف أدوات الذكاء الاصطناعي.</p>
      <button onclick="info('تعلم استخدام أدوات الذكاء الاصطناعي')">اكتشف المزيد</button>
    </div>

  </div>
  <p id="empty" hidden>لا توجد نتائج.</p>
</section>

<section id="quiz">
  <h2>🧠 اختبر معلوماتك</h2>
  <p>ما اللغة المستخدمة لبناء هيكل صفحات الويب؟</p>

  <div class="answers">
    <button onclick="answer(this,false)">CSS</button>
    <button onclick="answer(this,true)">HTML</button>
    <button onclick="answer(this,false)">Python</button>
  </div>

  <p id="result"></p>
</section>

<footer>
  <h3>EduSpace 🎓</h3>
  <p>التعلم هو بداية كل نجاح.</p>
  <p>© 2026 EduSpace</p>
</footer>

<script>
function info(message) {
  alert(message);
}

const search = document.getElementById("search");
const cards = document.querySelectorAll(".card");

search.addEventListener("input", function() {
  let count = 0;

  cards.forEach(card => {
    const found = card.textContent
      .toLowerCase()
      .includes(this.value.toLowerCase());

    card.style.display = found ? "block" : "none";
    if (found) count++;
  });

  document.getElementById("empty").hidden = count !== 0;
});

function answer(button, correct) {
  const result = document.getElementById("result");

  document.querySelectorAll(".answers button")
    .forEach(btn => btn.disabled = true);

  result.textContent = correct
    ? "🎉 إجابة صحيحة! أحسنت."
    : "❌ الإجابة الصحيحة هي HTML.";

  result.style.color = correct ? "green" : "red";
}
</script>

</body>
</html>
